{
  "expo": {
    "name": "Battlepad",
    "slug": "battlepad",
    "scheme": "battlepad",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.battlepad.app"
    },
    "android": {
      "package": "com.battlepad.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
